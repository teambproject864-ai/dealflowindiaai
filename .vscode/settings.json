{
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "args": [
        "-NoLogo",
        "-NoExit",
        "-Command",
        "$env:Path = 'C:\\Program Files\\Git\\cmd;C:\\Program Files\\nodejs;' + $env:Path"
      ]
    },
    "Windows PowerShell": {
      "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoExit",
        "-Command",
        "$env:Path = 'C:\\Program Files\\Git\\cmd;C:\\Program Files\\nodejs;' + $env:Path"
      ]
    }
  },
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "github-actions.workflows.pinned.enabled": false,
  "yaml.schemas": {
    "": ["**/.github/workflows/*.yml"]
  },
  "python.languageServer": "Pylance",
  "pyrefly.enable": false,
  "pyrefly.typeCheckingMode": "off",
  "pyrefly.disableTypeErrors": true,
  "pyrefly.disableLanguageServices": true,
  "pyrefly.displayErrors": false,
  "pyrefly.reportDiagnostics": false,
  "python.pyrefly.enable": false,
  "python.pyrefly.typeCheckingMode": "off",
  "python.pyrefly.disableTypeErrors": true,
  "python.pyrefly.disableLanguageServices": true,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "none",
    "reportUndefinedVariable": "none",
    "reportGeneralTypeIssues": "none"
  },
  "python.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/__pyrefly_virtual__",
    "d:/__pyrefly_virtual__/**",
    "D:\\__pyrefly_virtual__\\**"
  ],
  "python.analysis.ignore": [
    "d:/__pyrefly_virtual__/**",
    "D:\\__pyrefly_virtual__\\**"
  ],
  "pyrefly.projectExcludes": [
    "**/*",
    "**/inmemory/**",
    "**/virtual/**",
    "**/__pyrefly_virtual__/**",
    "D:/__pyrefly_virtual__/**",
    "D:\\__pyrefly_virtual__\\**"
  ],
  "files.exclude": {
    "**/__pyrefly_virtual__": true,
    "D:/__pyrefly_virtual__": true,
    "D:\\__pyrefly_virtual__": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/__pyrefly_virtual__/**": true,
    "D:/__pyrefly_virtual__/**": true,
    "D:\\__pyrefly_virtual__\\**": true
  }
}
