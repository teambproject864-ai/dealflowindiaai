{
  "include": [
    "python-agent-service/**/*.py"
  ],
  "exclude": [
    "**/*"
  ],
  "ignore": [
    "**/*"
  ],
  "pythonVersion": "3.10",
  "analysis": {
    "autoImportCompletions": false,
    "useLibraryCodeForTypes": false,
    "diagnosticMode": "openFilesOnly",
    "typeCheckingMode": "off"
  }
}
